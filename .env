VITE_COMPANY_NAME='Build Procure'
VITE_PROJECT_NAME='Admin Console'

# Microsoft Entra ID (Azure AD) app registration values
VITE_AZURE_CLIENT_ID=13d22488-c173-4256-8300-abef3e7c9e3e
VITE_AZURE_TENANT_ID=0f4f143b-570a-4c60-aa54-96f1d9d3fe2e

# Auth mode switch:
#   true  = browser authenticates directly with Entra ID via MSAL (current setup)
#   false = Spring Boot backend handles Entra ID login itself, browser just gets a session
VITE_USE_MSAL=false

# Java (Spring Boot) backend
VITE_API_BASE_URL=http://localhost:8080/api
VITE_AUTH_BASE_URL=http://localhost:8080/auth